# API Configuration
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_URL=postgres://portfolio:portfolio_dev@localhost:5432/portfolio

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# Authentication (required in production)
JWT_SECRET=your-secret-at-least-32-characters-long
ADMIN_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# Optional
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage Configuration
# STORAGE_BACKEND: 'local' or 'r2' (default: local)
STORAGE_BACKEND=local
UPLOADS_PATH=./uploads

# R2 Configuration (required when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.your-domain.com
