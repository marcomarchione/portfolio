---
/**
 * News Listing Page
 *
 * Displays a list of news articles with filtering and sorting.
 * Features:
 * - Tag filtering with clickable pills
 * - Sort by newest, oldest, or title
 * - Load More pagination (not page numbers)
 * - Glass morphism card design
 * - Vertical list layout
 */
import { LANGUAGES, type Language } from '@marcomarchione/shared';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import NewsFilterable from '../../../components/news/NewsFilterable';

// Enable SSR mode for dynamic content
export const prerender = false;

export async function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Get query parameters from URL
const url = new URL(Astro.request.url);
const initialTag = url.searchParams.get('tag') || '';
const initialSort = url.searchParams.get('sortBy') || 'newest';

// Build API URL
let apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api/v1';
// Ensure /api/v1 suffix is present
if (!apiBaseUrl.endsWith('/api/v1')) {
  apiBaseUrl = `${apiBaseUrl}/api/v1`;
}
const params = new URLSearchParams();
params.set('lang', lang);
if (initialTag) params.set('tag', initialTag);
if (initialSort && initialSort !== 'newest') params.set('sortBy', initialSort);
params.set('limit', '10');
params.set('offset', '0');

// Fetch initial news data
let initialNews = [];
let initialPagination = null;

try {
  const response = await fetch(`${apiBaseUrl}/news?${params.toString()}`);
  if (response.ok) {
    const data = await response.json();
    initialNews = data.data || [];
    initialPagination = data.pagination || null;
  }
} catch (error) {
  console.error('Error fetching news:', error);
}

// Page metadata
const title = t(lang, 'meta.newsTitle');
const description = t(lang, 'meta.newsDescription');

// Labels for NewsFilterable component
const labels = {
  title: t(lang, 'news.title'),
  filterByTag: t(lang, 'news.filterByTag'),
  sortBy: t(lang, 'news.sortBy'),
  sortNewest: t(lang, 'news.sortNewest'),
  sortOldest: t(lang, 'news.sortOldest'),
  sortTitle: t(lang, 'news.sortTitle'),
  loadMore: t(lang, 'news.loadMore'),
  noResults: t(lang, 'news.noResults'),
  all: t(lang, 'news.all'),
  readingTime: t(lang, 'common.readingTime'),
  featured: t(lang, 'common.featured'),
};
---

<BaseLayout lang={lang} title={title} description={description}>
  <div class="min-h-screen py-16">
    <div class="container mx-auto px-4 max-w-5xl">
      <!-- Page Header -->
      <header class="mb-12">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-white [.light_&]:text-neutral-900">
          {labels.title}
        </h1>
        <p class="text-xl text-neutral-400 [.light_&]:text-neutral-600">
          {description}
        </p>
      </header>

      <!-- Filterable News Component -->
      <NewsFilterable
        client:load
        lang={lang}
        initialNews={initialNews}
        initialPagination={initialPagination}
        initialTag={initialTag}
        initialSort={initialSort}
        labels={labels}
        apiBaseUrl={apiBaseUrl}
      />
    </div>
  </div>
</BaseLayout>
