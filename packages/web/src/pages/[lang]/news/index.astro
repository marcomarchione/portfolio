---
/**
 * News Listing Page
 *
 * Displays all published news articles with translations for the current language.
 */
import { LANGUAGES, type Language } from '@marcomarchione/shared';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { getNews } from '../../../lib/api';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Fetch news from API
const newsResponse = await getNews(lang).catch(() => null);
const news = newsResponse?.data ?? [];

const title = t(lang, 'meta.newsTitle');
const description = t(lang, 'meta.newsDescription');

// Helper to format date
function formatDate(dateString: string | null): string {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout lang={lang} title={title} description={description}>
  <main class="min-h-screen bg-bg-primary text-neutral-100">
    <div class="container mx-auto px-4 py-16">
      <h1 class="font-heading text-4xl font-bold mb-8">{t(lang, 'nav.news')}</h1>

      {news.length === 0 ? (
        <p class="text-neutral-400">{t(lang, 'common.noResults')}</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {news.map((article) => (
            <article class="bg-bg-secondary rounded-lg overflow-hidden border border-neutral-800 hover:border-primary-500 transition-colors">
              {article.coverImage && (
                <img
                  src={article.coverImage}
                  alt={article.translation?.title ?? article.slug}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-neutral-500 mb-2">
                  {article.publishedAt && (
                    <time datetime={article.publishedAt}>
                      {formatDate(article.publishedAt)}
                    </time>
                  )}
                  {article.readingTime && (
                    <span>
                      {t(lang, 'common.readingTime', { minutes: String(article.readingTime) })}
                    </span>
                  )}
                </div>

                <h2 class="font-heading text-xl font-semibold mb-2">
                  <a
                    href={`/${lang}/news/${article.slug}/`}
                    class="hover:text-primary-500 transition-colors"
                  >
                    {article.translation?.title ?? article.slug}
                  </a>
                </h2>

                {article.translation?.description && (
                  <p class="text-neutral-400 text-sm line-clamp-3">
                    {article.translation.description}
                  </p>
                )}

                {article.tags && article.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {article.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs px-2 py-1 bg-neutral-800 rounded">
                        {tag.name}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>
