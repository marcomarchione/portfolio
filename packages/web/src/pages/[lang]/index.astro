---
/**
 * Landing Page
 *
 * Main landing page for the portfolio website.
 * Features hero section, about section, and skills grid.
 * All content is static with i18n support.
 */
import { LANGUAGES, type Language } from '@marcomarchione/shared';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/utils';

// Landing page components
import GradientMeshBackground from '../../components/landing/GradientMeshBackground.astro';
import HeroSection from '../../components/landing/HeroSection.astro';
import AboutSection from '../../components/landing/AboutSection.astro';
import SkillsSection from '../../components/landing/SkillsSection.astro';
import ScrollAnimations from '../../components/landing/ScrollAnimations.astro';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Page meta
const title = t(lang, 'meta.siteTitle');
const description = t(lang, 'meta.siteDescription');
---

<BaseLayout lang={lang} title={title} description={description}>
  <!-- Full-page gradient mesh background -->
  <GradientMeshBackground />

  <!-- Hero Section - Full viewport height -->
  <HeroSection />

  <!-- About Section -->
  <AboutSection lang={lang} />

  <!-- Skills/Technologies Section -->
  <SkillsSection lang={lang} />

  <!-- Scroll animation handler -->
  <ScrollAnimations />
</BaseLayout>
