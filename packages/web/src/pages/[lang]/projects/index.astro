---
/**
 * Projects Listing Page
 *
 * Displays all published projects with translations for the current language.
 */
import { LANGUAGES, type Language } from '@marcomarchione/shared';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { getProjects } from '../../../lib/api';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Fetch projects from API
const projectsResponse = await getProjects(lang).catch(() => null);
const projects = projectsResponse?.data ?? [];

const title = t(lang, 'meta.projectsTitle');
const description = t(lang, 'meta.projectsDescription');
---

<BaseLayout lang={lang} title={title} description={description}>
  <section class="min-h-screen">
    <div class="container mx-auto px-4 py-16">
      <h1 class="font-heading text-4xl font-bold mb-8 text-white [.light_&]:text-neutral-900">{t(lang, 'nav.projects')}</h1>

      {projects.length === 0 ? (
        <p class="text-neutral-400 [.light_&]:text-neutral-600">{t(lang, 'common.noResults')}</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {projects.map((project) => (
            <article class="bg-bg-secondary [.light_&]:bg-white rounded-lg p-6 border border-neutral-800 [.light_&]:border-neutral-200 hover:border-primary-500 [.light_&]:hover:border-primary-400 transition-all duration-300">
              <h2 class="font-heading text-xl font-semibold mb-2 text-white [.light_&]:text-neutral-900">
                <a
                  href={`/${lang}/projects/${project.slug}/`}
                  class="hover:text-primary-400 [.light_&]:hover:text-primary-600 transition-colors"
                >
                  {project.translation?.title ?? project.slug}
                </a>
              </h2>
              {project.translation?.description && (
                <p class="text-neutral-400 [.light_&]:text-neutral-600 text-sm line-clamp-3">
                  {project.translation.description}
                </p>
              )}
              {project.featured && (
                <span class="inline-block mt-3 text-xs text-accent-500 [.light_&]:text-accent-600 font-medium">
                  {t(lang, 'common.featured')}
                </span>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
