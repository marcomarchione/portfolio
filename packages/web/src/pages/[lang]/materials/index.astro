---
/**
 * Materials Listing Page
 *
 * Displays all published materials with client-side filtering for smooth UX.
 * Features:
 * - Category filter (clickable pills)
 * - Search functionality (debounced)
 * - Sort options (newest, oldest, title)
 * - Pagination
 * - Featured materials appear first
 * - Smooth transitions on filter change (no page reload)
 */
import { LANGUAGES, type Language } from '@marcomarchione/shared';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { getMaterials, type MaterialSortOption } from '../../../lib/api';
import MaterialsFilterable from '../../../components/materials/MaterialsFilterable';

// Disable prerendering for SSR - enables dynamic URL parameter filtering
export const prerender = false;

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };

// Parse URL query parameters for initial server-side rendering
const url = new URL(Astro.request.url);
const categoryParam = url.searchParams.get('category') || '';
const searchParam = url.searchParams.get('search') || '';
const sortByParam = (url.searchParams.get('sortBy') || 'newest') as MaterialSortOption;
const pageParam = parseInt(url.searchParams.get('page') || '1', 10);
const ITEMS_PER_PAGE = 9;
const offset = (pageParam - 1) * ITEMS_PER_PAGE;

// Fetch initial materials from API (for SSR)
const materialsResponse = await getMaterials(lang, {
  category: categoryParam || undefined,
  search: searchParam || undefined,
  sortBy: sortByParam,
  limit: ITEMS_PER_PAGE,
  offset,
}).catch(() => null);

const materials = materialsResponse?.data ?? [];
const pagination = materialsResponse?.pagination ?? null;

const title = t(lang, 'meta.materialsTitle');
const description = t(lang, 'meta.materialsDescription');

// API base URL for client-side fetching
// PUBLIC_BROWSER_API_URL is the URL the browser uses to reach the API
// In dev: http://localhost:3000, in prod: the public API URL
const apiBaseUrl = (import.meta.env.PUBLIC_BROWSER_API_URL || 'http://localhost:3000') + '/api/v1';
---

<BaseLayout lang={lang} title={title} description={description}>
  <section class="min-h-screen py-16">
    <div class="container mx-auto px-4">
      <!-- Page Header -->
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-8 text-white [.light_&]:text-neutral-900">
        {t(lang, 'nav.materials')}
      </h1>

      <!-- Filterable Materials Section (React Island) -->
      <MaterialsFilterable
        client:load
        lang={lang}
        initialMaterials={materials}
        initialPagination={pagination}
        initialCategory={categoryParam}
        initialSearch={searchParam}
        initialSort={sortByParam}
        initialPage={pageParam}
        apiBaseUrl={apiBaseUrl}
        labels={{
          filterByCategory: t(lang, 'materials.filterByCategory'),
          search: t(lang, 'materials.search'),
          searchPlaceholder: t(lang, 'materials.searchPlaceholder'),
          sortBy: t(lang, 'materials.sortBy'),
          all: t(lang, 'materials.category.all'),
          categoryGuide: t(lang, 'materials.category.guide'),
          categoryTemplate: t(lang, 'materials.category.template'),
          categoryResource: t(lang, 'materials.category.resource'),
          categoryTool: t(lang, 'materials.category.tool'),
          sortNewest: t(lang, 'materials.sort.newest'),
          sortOldest: t(lang, 'materials.sort.oldest'),
          sortTitle: t(lang, 'materials.sort.title'),
          featured: t(lang, 'common.featured'),
          noResults: t(lang, 'materials.noResults'),
          previous: t(lang, 'materials.pagination.previous'),
          next: t(lang, 'materials.pagination.next'),
          page: t(lang, 'materials.pagination.page'),
          of: t(lang, 'materials.pagination.of'),
        }}
      />
    </div>
  </section>
</BaseLayout>
