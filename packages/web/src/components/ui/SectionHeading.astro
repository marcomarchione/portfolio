---
/**
 * SectionHeading Component
 *
 * Medium-sized heading component for subsections and content areas.
 * Uses Space Grotesk font with medium weight.
 *
 * @example
 * <SectionHeading level={3}>About This Project</SectionHeading>
 * <SectionHeading level={4} class="mb-4">Technical Details</SectionHeading>
 */

export interface Props {
  /** Heading level: 3 for H3, 4 for H4 */
  level: 3 | 4;
  /** Additional CSS classes */
  class?: string;
}

const { level, class: className = '' } = Astro.props;

const Tag = `h${level}` as 'h3' | 'h4';

const baseStyles = 'font-heading font-medium tracking-tight';

const levelStyles = {
  3: 'text-2xl md:text-3xl',
  4: 'text-xl md:text-2xl',
};

const combinedStyles = `${baseStyles} ${levelStyles[level]} ${className}`.trim();
---

<Tag class={combinedStyles}>
  <slot />
</Tag>
