---
/**
 * GradientText Component
 *
 * Text with gradient fill from Agent Blue to Neural Violet.
 * Used for emphasis and visual accent.
 *
 * @example
 * <GradientText>Highlighted Text</GradientText>
 * <h1>Welcome to <GradientText>My Portfolio</GradientText></h1>
 */

export interface Props {
  /** Additional CSS classes */
  class?: string;
}

const { class: className = '' } = Astro.props;

const baseStyles = 'bg-[linear-gradient(135deg,var(--color-primary-400),var(--color-primary-500),var(--color-accent-400),var(--color-accent-500),var(--color-primary-400))] [.light_&]:bg-[linear-gradient(135deg,var(--color-cream-500),var(--color-cream-600),var(--color-terra-500),var(--color-terra-600),var(--color-cream-500))] bg-clip-text text-transparent animate-gradient-wave';

const combinedStyles = `${baseStyles} ${className}`.trim();
---

<span class={combinedStyles}>
  <slot />
</span>
