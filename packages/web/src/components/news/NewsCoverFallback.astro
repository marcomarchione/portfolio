---
/**
 * NewsCoverFallback Component
 *
 * Fallback cover image for news articles without a cover image.
 * Displays centered "MM" text with theme-aware styling and 16:9 aspect ratio.
 */
---

<div
  class="w-full aspect-video flex items-center justify-center bg-neutral-800 text-neutral-400 border border-neutral-700/50 rounded-lg [.light_&]:bg-neutral-200 [.light_&]:text-neutral-600 [.light_&]:border-neutral-300"
  role="img"
  aria-label="Default cover image"
>
  <span class="font-heading font-bold text-4xl select-none">
    MM
  </span>
</div>
