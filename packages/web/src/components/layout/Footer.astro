---
/**
 * Footer Component
 *
 * Multi-section footer with navigation, legal links, social links, and copyright.
 * Pure Astro component with no client-side JavaScript.
 *
 * @example
 * <Footer lang="it" />
 */
import type { Language } from '@marcomarchione/shared';
import { getLocalizedPath } from '../../i18n/config';
import { t } from '../../i18n/utils';

export interface Props {
  /** Current language code */
  lang: Language;
}

const { lang } = Astro.props;

/** Navigation links configuration */
const navLinks = [
  { key: 'home' as const, route: 'home' as const },
  { key: 'projects' as const, route: 'projects' as const },
  { key: 'materials' as const, route: 'materials' as const },
  { key: 'news' as const, route: 'news' as const },
] as const;

/** Legal links configuration */
const legalLinks = [
  { key: 'privacyPolicy' as const, route: 'privacyPolicy' as const },
  { key: 'cookiePolicy' as const, route: 'cookiePolicy' as const },
] as const;

/** Social links configuration */
const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/marcomarchione',
    icon: 'linkedin',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/marcomarchione',
    icon: 'github',
  },
] as const;

const currentYear = new Date().getFullYear();
const contactEmail = 'mmarchione.code@gmail.com';
---

<footer id="main-footer" class="bg-neutral-900/50 border-t border-white/10 [.light_&]:bg-[#EBE4D8] [.light_&]:border-[#E5DED4]">
  <div class="container mx-auto px-4 py-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <!-- Section 1: Navigation Links -->
      <div>
        <h3 class="font-heading font-medium text-lg mb-4 text-white [.light_&]:text-neutral-900">
          {t(lang, 'nav.home')}
        </h3>
        <nav aria-label="Footer navigation">
          <ul class="space-y-2">
            {navLinks.map((link) => (
              <li>
                <a
                  href={getLocalizedPath(lang, link.route)}
                  class="text-neutral-400 hover:text-white transition-colors [.light_&]:text-neutral-600 [.light_&]:hover:text-neutral-900"
                >
                  {t(lang, `nav.${link.key}`)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Section 2: Legal Links -->
      <div>
        <h3 class="font-heading font-medium text-lg mb-4 text-white [.light_&]:text-neutral-900">
          Legal
        </h3>
        <nav aria-label="Legal links">
          <ul class="space-y-2">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={getLocalizedPath(lang, link.route)}
                  class="text-neutral-400 hover:text-white transition-colors [.light_&]:text-neutral-600 [.light_&]:hover:text-neutral-900"
                >
                  {t(lang, `footer.${link.key}`)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Section 3: Social & Contact -->
      <div>
        <h3 class="font-heading font-medium text-lg mb-4 text-white [.light_&]:text-neutral-900">
          {t(lang, 'nav.contact')}
        </h3>

        <!-- Social Links -->
        <div class="flex gap-4 mb-4">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-neutral-400 hover:text-white transition-colors [.light_&]:text-neutral-600 [.light_&]:hover:text-neutral-900"
              aria-label={social.name}
            >
              {social.icon === 'linkedin' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'github' && (
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                </svg>
              )}
            </a>
          ))}
        </div>

        <!-- Email -->
        <a
          href={`mailto:${contactEmail}`}
          class="text-neutral-400 hover:text-primary-400 transition-colors [.light_&]:text-neutral-600 [.light_&]:hover:text-primary-600"
        >
          {contactEmail}
        </a>
      </div>
    </div>

    <!-- Copyright Section -->
    <div class="border-t border-white/10 mt-8 pt-8 [.light_&]:border-neutral-200">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-neutral-500 text-sm">
          &copy; {currentYear} Marco Marchione. {t(lang, 'footer.copyright')}
        </p>
        <p class="text-neutral-500 text-sm flex items-center gap-1">
          {t(lang, 'footer.madeWith')}
          <svg class="h-4 w-4 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"/>
          </svg>
          <span class="sr-only">love</span>
          in Italy
        </p>
      </div>
    </div>
  </div>
</footer>
