<section id="skills" class="py-16 md:py-24 px-4">
  <div class="container mx-auto">
    <div class="text-center mb-12">
      <SectionHeading level={3} class="text-white [.light_&]:text-neutral-900">
        {t(lang, 'landing.skills.title')}
      </SectionHeading>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 max-w-4xl mx-auto">
      {
        technologies.map((tech, index) => (
          <TechnologyItem name={tech.name} icon={tech.icon} index={index} />
        ))
      }
    </div>
  </div>
</section>
