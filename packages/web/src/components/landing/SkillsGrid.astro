---
/**
 * SkillsGrid Component
 *
 * Simple grid layout for displaying technologies fetched from API.
 * Each technology shows icon, name, and color from database.
 * Clean hover effects and tooltips.
 *
 * @example
 * <SkillsGrid lang="en" apiUrl="http://localhost:3000" />
 */
import type { Language } from '@marcomarchione/shared';
import SectionHeading from '../ui/SectionHeading.astro';
import { t } from '../../i18n/utils';

export interface Props {
  lang: Language;
  apiUrl: string;
}

const { lang, apiUrl } = Astro.props;

interface Technology {
  id: string;
  slug: string;
  name: string;
  icon: string | null;
  color: string | null;
}

let technologies: Technology[] = [];

try {
  const response = await fetch(`${apiUrl}/api/v1/technologies`);
  if (response.ok) {
    const data = await response.json();
    technologies = data.data || [];
  }
} catch (error) {
  console.error('Failed to fetch technologies:', error);
}

