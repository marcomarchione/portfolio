function getIconPath(icon: string | null): string {
  if (!icon) return iconPaths.default;
  return iconPaths[icon.toLowerCase()] || iconPaths.default;
}
---

<section id="skills" class="py-16 md:py-24 px-4">
  <div class="container mx-auto">
    <SectionHeading level={2} class="text-center mb-12 text-white [.light_&]:text-neutral-900">
      {t(lang, 'landing.skills.title')}
    </SectionHeading>

    <!-- Dark container for icon visibility in both themes -->
    <div class="bg-neutral-900/80 backdrop-blur-xl rounded-2xl p-6 md:p-8 border border-white/10 max-w-4xl mx-auto">
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4">
        {technologies.map((tech) => {
          const color = tech.color || '#3d7eff';
          return (
            <div
              class="skill-item group relative flex flex-col items-center p-4 rounded-xl bg-white/5 border border-white/10 hover:border-white/30 hover:bg-white/10 transition-all duration-300 cursor-pointer"
            >
            {/* Icon */}
            <div
              class="w-12 h-12 rounded-full flex items-center justify-center mb-2 transition-transform duration-300 group-hover:scale-110"
              style={`background: ${color}20; border: 2px solid ${color}50;`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke={color}
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={getIconPath(tech.icon)} />
              </svg>
            </div>

            {/* Name */}
            <span
              class="text-xs font-medium text-center text-neutral-300 group-hover:text-white transition-colors"
            >
              {tech.name}
            </span>

            {/* Glow effect on hover */}
            <div
              class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
              style={`box-shadow: 0 0 30px ${color}30, inset 0 0 20px ${color}10;`}
            />
          </div>
        );
      })}
      </div>
    </div>

    {technologies.length === 0 && (
      <p class="text-center text-neutral-500 text-sm">
        Caricamento tecnologie...
      </p>
    )}
  </div>
</section>
