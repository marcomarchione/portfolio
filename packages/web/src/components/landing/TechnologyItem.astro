---
/**
 * TechnologyItem Component
 *
 * Individual technology item with icon and name for the skills grid.
 * Includes hover effect with scale and glow.
 *
 * @example
 * <TechnologyItem name="TypeScript" icon={typescriptSvg} />
 */

export interface Props {
  /** Technology name */
  name: string;
  /** SVG icon as string (inline SVG) */
  icon: string;
  /** Animation delay index for staggered animations */
  index?: number;
}

const { name, icon, index = 0 } = Astro.props;

// Calculate animation delay based on index
const delayClass = index < 6 ? `animate-delay-${(index + 1) * 100}` : '';
---

<div
  data-tech-item
  class:list={[
    'tech-item-glow flex flex-col items-center justify-center p-4 rounded-xl',
    'bg-white/5 border border-white/10 [.light_&]:bg-neutral-100 [.light_&]:border-neutral-200',
    delayClass,
  ]}
>
  <div
    class="w-12 h-12 mb-3 flex items-center justify-center text-neutral-300 [.light_&]:text-neutral-700"
    set:html={icon}
  />
  <span class="text-sm text-neutral-400 [.light_&]:text-neutral-600 text-center font-medium">
    {name}
  </span>
</div>
