---
/**
 * ComparisonBar Component
 *
 * Single comparison metric with two bars (traditional vs agent developer).
 * Bars animate to their width values when visible.
 *
 * @example
 * <ComparisonBar
 *   label="Code Speed"
 *   traditionalValue={40}
 *   agentValue={85}
 *   index={0}
 * />
 */

export interface Props {
  /** Metric label */
  label: string;
  /** Traditional developer percentage (0-100) */
  traditionalValue: number;
  /** Agent developer percentage (0-100) */
  agentValue: number;
  /** Index for animation delay */
  index: number;
}

const { label, traditionalValue, agentValue, index } = Astro.props;
---

<div
  class="comparison-metric animate-on-scroll"
  style={`--stagger-delay: ${index * 100}ms;`}
>
  <p class="text-sm text-neutral-300 [.light_&]:text-neutral-700 mb-3 font-medium">
    {label}
  </p>

  <div class="space-y-2">
    <!-- Traditional Developer Bar -->
    <div class="flex items-center gap-3">
      <div class="w-20 text-xs text-neutral-500 [.light_&]:text-neutral-500 flex-shrink-0">
        Traditional
      </div>
      <div class="flex-1 h-6 bg-white/5 [.light_&]:bg-neutral-200 rounded-full overflow-hidden">
        <div
          class="comparison-bar h-full bg-gradient-to-r from-neutral-600 to-neutral-500 [.light_&]:from-neutral-400 [.light_&]:to-neutral-300 rounded-full flex items-center justify-end pr-2"
          style={`--bar-width: ${traditionalValue}%;`}
        >
          <span class="text-xs font-medium text-white [.light_&]:text-neutral-700">{traditionalValue}%</span>
        </div>
      </div>
    </div>

    <!-- Agent Developer Bar -->
    <div class="flex items-center gap-3">
      <div class="w-20 text-xs text-primary-400 [.light_&]:text-terra-600 flex-shrink-0 font-medium">
        Agent Dev
      </div>
      <div class="flex-1 h-6 bg-white/5 [.light_&]:bg-neutral-200 rounded-full overflow-hidden">
        <div
          class="comparison-bar h-full bg-gradient-to-r from-primary-500 to-accent-500 [.light_&]:from-terra-500 [.light_&]:to-terra-400 rounded-full flex items-center justify-end pr-2"
          style={`--bar-width: ${agentValue}%;`}
        >
          <span class="text-xs font-medium text-white">{agentValue}%</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .comparison-metric {
    opacity: 0;
    transition: opacity 0.4s ease-out;
    transition-delay: var(--stagger-delay, 0ms);
  }

  .comparison-metric.animate-visible {
    opacity: 1;
  }

  .comparison-metric .comparison-bar {
    width: 0;
    transition: width 1s ease-out;
    transition-delay: calc(var(--stagger-delay, 0ms) + 300ms);
  }

  .comparison-metric.animate-visible .comparison-bar {
    width: var(--bar-width, 0%);
  }
</style>
