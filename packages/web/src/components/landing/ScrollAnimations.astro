---
/**
 * ScrollAnimations Component
 *
 * Client-side script that uses IntersectionObserver to trigger
 * scroll-based animations. Respects prefers-reduced-motion.
 *
 * @example
 * <!-- Add to page layout -->
 * <ScrollAnimations />
 */
---

<script is:inline>
  (function() {
    // Prevent multiple initializations
    if (window.__scrollAnimationsInitialized) return;
    window.__scrollAnimationsInitialized = true;

    // Initialize scroll animations
    function initScrollAnimations() {
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (prefersReducedMotion) {
        document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
          el.classList.add('animate-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          root: null,
          rootMargin: '0px 0px -50px 0px',
          threshold: 0.1,
        }
      );

      document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
        observer.observe(el);
      });
    }

    // Reset animations for SPA navigation
    function resetScrollAnimations() {
      document.querySelectorAll('.animate-on-scroll.animate-visible').forEach(function(el) {
        el.classList.remove('animate-visible');
      });

      document.querySelectorAll('.animate-draw-line, .time-savings-bar, .time-distribution-segment').forEach(function(el) {
        el.style.animation = 'none';
        void el.offsetHeight;
        el.style.animation = '';
      });
    }

    // Run on initial load
    initScrollAnimations();

    // Handle View Transitions navigation
    document.addEventListener('astro:page-load', function() {
      resetScrollAnimations();
      initScrollAnimations();
    });
  })();
</script>
