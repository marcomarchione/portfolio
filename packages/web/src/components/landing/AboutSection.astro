---
/**
 * AboutSection Component
 *
 * Compact about section with translated title and text.
 *
 * @example
 * <AboutSection lang="en" />
 */
import type { Language } from '@marcomarchione/shared';
import { t } from '../../i18n/utils';

export interface Props {
  /** Current language code */
  lang: Language;
}

const { lang } = Astro.props;
---

<section id="about" class="pt-10 pb-4 md:pt-12 md:pb-6 px-4">
  <div class="container mx-auto">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-lg p-4 md:p-5 [.light_&]:bg-[#EBE4D8] [.light_&]:border-[#E5DED4]">
        <h2 class="font-heading font-medium text-lg md:text-xl mb-2 text-white [.light_&]:text-neutral-900">
          {t(lang, 'landing.about.title')}
        </h2>
        <p class="text-neutral-300 [.light_&]:text-neutral-700 leading-relaxed text-sm">
          {t(lang, 'landing.about.text')}
        </p>
      </div>
    </div>
  </div>
</section>
