---
/**
 * DeveloperComparisonChart Component
 *
 * Visual comparison between traditional software developer and agent developer.
 * Layout:
 * - Top: Time Savings (full width)
 * - Bottom: Time Distribution (left) | Learning Curve (right)
 *
 * @example
 * <DeveloperComparisonChart lang="en" />
 */
import type { Language } from '@marcomarchione/shared';
import SectionHeading from '../ui/SectionHeading.astro';
import LearningCurveChart from './LearningCurveChart.astro';
import TimeSavingsChart from './TimeSavingsChart.astro';
import TimeDistributionChart from './TimeDistributionChart.astro';
import { t } from '../../i18n/utils';

export interface Props {
  /** Current language code */
  lang: Language;
}

const { lang } = Astro.props;
---

<section id="comparison" class="py-8 md:py-12 px-4">
  <div class="container mx-auto">
    <div class="text-center mb-6">
      <SectionHeading level={2} class="text-white [.light_&]:text-neutral-900 mb-2">
        {t(lang, 'landing.comparison.title')}
      </SectionHeading>
      <p class="text-neutral-400 [.light_&]:text-neutral-600 max-w-2xl mx-auto text-sm">
        {t(lang, 'landing.comparison.subtitle')}
      </p>
    </div>

    <div class="flex flex-col gap-4 max-w-6xl mx-auto">
      <!-- Top: Time Savings (full width) -->
      <div class="w-full">
        <TimeSavingsChart lang={lang} />
      </div>

      <!-- Bottom row: Time Distribution (left) | Learning Curve (right) -->
      <div class="flex flex-col lg:flex-row gap-4 items-stretch">
        <!-- Time Distribution -->
        <div class="flex-1 w-full flex">
          <div class="w-full">
            <TimeDistributionChart lang={lang} />
          </div>
        </div>

        <!-- Learning Curve -->
        <div class="flex-1 w-full flex">
          <div class="w-full">
            <LearningCurveChart lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
