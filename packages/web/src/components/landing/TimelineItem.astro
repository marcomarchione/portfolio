---
/**
 * TimelineItem Component
 *
 * Single item in the experience timeline with date, role, company and description.
 * Alternates position on desktop (left/right).
 * Uses scroll-triggered slide animation.
 *
 * @example
 * <TimelineItem
 *   date="2023 - Presente"
 *   role="Senior Developer"
 *   company="Acme Corp"
 *   description="Building amazing products..."
 *   position="left"
 *   index={0}
 * />
 */

export interface Props {
  /** Time period (e.g., "2023 - Present") */
  date: string;
  /** Job title/role */
  role: string;
  /** Company name */
  company: string;
  /** Job description */
  description: string;
  /** Position: left or right (alternates on desktop) */
  position: 'left' | 'right';
  /** Index for animation delay */
  index: number;
}

const { date, role, company, description, position, index } = Astro.props;

const slideClass = position === 'left' ? 'timeline-slide-left' : 'timeline-slide-right';
const alignmentClass = position === 'left'
  ? 'md:pr-12 md:text-right'
  : 'md:pl-12 md:text-left';
const gridColumn = position === 'left'
  ? 'md:col-start-1 md:col-end-2'
  : 'md:col-start-2 md:col-end-3';
---

<div
  class={`${slideClass} animate-on-scroll ${gridColumn} ${alignmentClass} relative pl-8 md:pl-0`}
  style={`--animation-delay: ${index * 150}ms;`}
>
  <!-- Mobile dot (visible on small screens) -->
  <div class="absolute left-0 top-2 w-3 h-3 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 md:hidden" />

  <!-- Desktop dot (positioned on center line) -->
  <div class={`hidden md:block absolute top-2 w-3 h-3 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 ${position === 'left' ? 'right-0 translate-x-[calc(50%+1.5rem)]' : 'left-0 -translate-x-[calc(50%+1.5rem)]'}`} />

  <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-5 hover:border-white/20 hover:bg-white/[0.07] transition-all duration-300 [.light_&]:bg-[#EBE4D8] [.light_&]:border-[#E5DED4] [.light_&]:hover:border-[#D8D0C4] [.light_&]:hover:bg-[#E5DED4]">
    <span class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-primary-500/20 text-primary-400 [.light_&]:bg-terra-500/20 [.light_&]:text-terra-600 mb-3">
      {date}
    </span>

    <h4 class="text-lg font-semibold text-white [.light_&]:text-neutral-900 mb-1">
      {role}
    </h4>

    <p class="text-primary-400 [.light_&]:text-terra-600 text-sm font-medium mb-3">
      {company}
    </p>

    <p class="text-neutral-400 [.light_&]:text-neutral-600 text-sm leading-relaxed">
      {description}
    </p>
  </div>
</div>
