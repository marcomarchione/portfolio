---
/**
 * GlassCard Component
 *
 * Transparent container with backdrop blur for overlay contexts.
 * Best used on dark backgrounds for the glass effect.
 *
 * Note: Glass effect works best on dark backgrounds. On light mode,
 * the effect is more subtle.
 *
 * @example
 * <GlassCard>
 *   <h2>Card Title</h2>
 *   <p>Card content goes here.</p>
 * </GlassCard>
 * <GlassCard href="/about">
 *   <span>Clickable card</span>
 * </GlassCard>
 */

export interface Props {
  /** Link URL - makes the entire card clickable */
  href?: string;
  /** Additional CSS classes */
  class?: string;
}

const { href, class: className = '' } = Astro.props;

const baseStyles = 'bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl p-6 md:p-8 [.light_&]:bg-[#EBE4D8] [.light_&]:border-[#E5DED4]';
const hoverStyles = 'hover:border-white/20 hover:bg-white/[0.07] transition-all duration-300 [.light_&]:hover:border-[#D8D0C4] [.light_&]:hover:bg-[#E5DED4]';

const combinedStyles = `${baseStyles} ${hoverStyles} ${className}`.trim();

const Tag = href ? 'a' : 'div';
---

{Tag === 'a' ? (
  <a href={href} class={`block ${combinedStyles}`}>
    <slot />
  </a>
) : (
  <div class={combinedStyles}>
    <slot />
  </div>
)}
