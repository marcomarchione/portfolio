---
/**
 * BaseLayout Component
 *
 * Main layout component with i18n support, SEO meta tags, and theme handling.
 * All pages should use this layout for consistent structure.
 */
import { LANGUAGES, DEFAULT_LANGUAGE, type Language } from '@marcomarchione/shared';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  /** Current language code */
  lang: Language;
  /** Page title */
  title: string;
  /** Meta description for SEO */
  description?: string;
  /** Canonical URL for the page */
  canonicalUrl?: string;
  /** Open Graph image URL */
  ogImage?: string;
  /** Whether to show the header (default: true) */
  showHeader?: boolean;
  /** Whether to show the footer (default: true) */
  showFooter?: boolean;
}

const {
  lang,
  title,
  description = 'Full Stack Developer Portfolio',
  canonicalUrl,
  ogImage = '/og-default.png',
  showHeader = true,
  showFooter = true,
} = Astro.props;

// Derive the current path without language prefix for hreflang generation
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(new RegExp(`^/${lang}/?`), '/');

// Build the canonical URL if not provided
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = canonicalUrl || `${siteUrl}${currentPath}`;

// Build Open Graph URL
const ogUrl = canonical;

// Build OG image URL
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <!-- Theme detection - must be first to prevent flash -->
    <script is:inline>
      (function() {
        function applyTheme() {
          var html = document.documentElement;
          var theme = localStorage.getItem('theme');

          // Remove existing theme classes
          html.classList.remove('light', 'dark');

          if (theme === 'light') {
            html.classList.add('light');
          } else if (theme === 'dark') {
            html.classList.add('dark');
          } else {
            // System preference, default to dark
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            html.classList.add(prefersDark ? 'dark' : 'light');
          }

          // Mark theme as ready
          if (!html.classList.contains('theme-ready')) {
            if (document.fonts && document.fonts.ready) {
              document.fonts.ready.then(function() {
                requestAnimationFrame(function() {
                  html.classList.add('theme-ready');
                });
              });
            } else {
              setTimeout(function() {
                html.classList.add('theme-ready');
              }, 50);
            }
          }
        }

        // Apply on initial load
        applyTheme();

      })();

      // CUSTOM SPA NAVIGATION - preserves header/footer, only swaps main
      (function() {
        // Intercept all internal link clicks
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;

          var href = link.getAttribute('href');
          if (!href) return;

          // Only handle internal links
          if (href.startsWith('http') && !href.startsWith(window.location.origin)) return;
          if (href.startsWith('#')) return;
          if (link.hasAttribute('download')) return;
          if (link.target === '_blank') return;

          // Prevent default navigation
          e.preventDefault();

          // Navigate using custom SPA
          navigateTo(href);
        });

        // Handle browser back/forward
        window.addEventListener('popstate', function() {
          navigateTo(window.location.pathname, true);
        });

        // Expose globally for React components
        window.spaNavigate = navigateTo;

        // Track current language
        var currentLang = window.location.pathname.match(/^\/([a-z]{2})(\/|$)/)?.[1] || 'it';

        async function navigateTo(url, isPopState) {
          // Skip if already on the same page
          var currentUrl = window.location.pathname;
          var targetUrl = url.split('?')[0].split('#')[0];
          if (currentUrl === targetUrl && !isPopState) {
            return;
          }

          try {
            // Fetch new page
            var response = await fetch(url);
            var html = await response.text();

            // Parse the HTML
            var parser = new DOMParser();
            var newDoc = parser.parseFromString(html, 'text/html');

            // Check if language changed
            var newLang = url.match(/^\/([a-z]{2})(\/|$)/)?.[1] || 'it';
            var langChanged = newLang !== currentLang;

            // Get new main content
            var newMain = newDoc.querySelector('main');
            var currentMain = document.querySelector('main');

            if (newMain && currentMain) {
              // Fade out current content
              currentMain.style.opacity = '0';
              currentMain.style.transition = 'opacity 100ms ease-out';

              await new Promise(function(r) { setTimeout(r, 100); });

              // Replace content
              currentMain.innerHTML = newMain.innerHTML;

              // Fade in new content
              currentMain.style.opacity = '1';
            }

            // If language changed, update header navigation
            if (langChanged) {
              var newHeader = newDoc.querySelector('#main-header');
              var currentHeader = document.querySelector('#main-header');
              if (newHeader && currentHeader) {
                // Update navigation links (href and text)
                var newNavLinks = newHeader.querySelectorAll('[data-nav-link]');
                var currentNavLinks = currentHeader.querySelectorAll('[data-nav-link]');
                newNavLinks.forEach(function(newLink, i) {
                  if (currentNavLinks[i]) {
                    currentNavLinks[i].setAttribute('href', newLink.getAttribute('href'));
                    currentNavLinks[i].textContent = newLink.textContent;
                  }
                });

                // Update logo link
                var newLogo = newHeader.querySelector('a[href^="/"]');
                var currentLogo = currentHeader.querySelector('a[href^="/"]');
                if (newLogo && currentLogo) {
                  currentLogo.setAttribute('href', newLogo.getAttribute('href'));
                }
              }

              // Update footer links too
              var newFooter = newDoc.querySelector('#main-footer');
              var currentFooter = document.querySelector('#main-footer');
              if (newFooter && currentFooter) {
                currentFooter.innerHTML = newFooter.innerHTML;
              }

              currentLang = newLang;
            }

            // Update title
            document.title = newDoc.title;

            // Update URL (unless popstate)
            if (!isPopState) {
              history.pushState({}, '', url);
            }

            // Update active nav links
            updateNavLinks();

            // Scroll to top
            window.scrollTo(0, 0);

          } catch (err) {
            // Fallback to normal navigation on error
            console.error('SPA navigation failed:', err);
            window.location.href = url;
          }
        }

        function updateNavLinks() {
          var currentPath = window.location.pathname;
          var navLinks = document.querySelectorAll('[data-nav-link]');

          navLinks.forEach(function(link) {
            var href = link.getAttribute('href') || '';
            var isHome = link.hasAttribute('data-nav-home');
            var isActive = currentPath.startsWith(href) && (isHome ? currentPath === href : true);

            // Update classes
            link.classList.remove('text-primary-400', '[.light_&]:text-cream-600',
              'text-neutral-300', 'hover:text-white', '[.light_&]:text-neutral-600', '[.light_&]:hover:text-neutral-900');

            if (isActive) {
              link.classList.add('text-primary-400', '[.light_&]:text-cream-600');
              link.setAttribute('aria-current', 'page');
            } else {
              link.classList.add('text-neutral-300', 'hover:text-white', '[.light_&]:text-neutral-600', '[.light_&]:hover:text-neutral-900');
              link.removeAttribute('aria-current');
            }
          });
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- hreflang Tags for SEO -->
    {LANGUAGES.map((langCode) => (
      <link
        rel="alternate"
        hreflang={langCode}
        href={`${siteUrl}/${langCode}${pathWithoutLang}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/${DEFAULT_LANGUAGE}${pathWithoutLang}`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang} />
    {LANGUAGES.filter((l) => l !== lang).map((altLang) => (
      <meta property="og:locale:alternate" content={altLang} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Font Preloading -->
    <link
      rel="preload"
      href="/src/styles/fonts/space-grotesk-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/src/styles/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Custom SPA navigation without View Transitions -->
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary text-neutral-100 [.light_&]:bg-[#F5EFE6] [.light_&]:text-neutral-900">
    {showHeader && <Header lang={lang} currentPath={currentPath} />}
    <main class="flex-1">
      <slot />
    </main>
    {showFooter && <Footer lang={lang} />}
  </body>
</html>
