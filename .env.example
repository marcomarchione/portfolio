# Environment Variables for Docker / Railway
# Copy this file to .env and fill in the values
#
# For Railway deployment, see DEPLOY.md

# PostgreSQL Database (for production)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=portfolio

# Authentication (required in production)
JWT_SECRET=your-jwt-secret-at-least-32-characters
ADMIN_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# CORS Origins (comma-separated, for production)
CORS_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com

# Public URL for browser access (production)
PUBLIC_BROWSER_API_URL=https://api.yourdomain.com

# Storage Configuration
# Options: 'local' or 'r2' (default: local)
STORAGE_BACKEND=local

# R2 Configuration (required when STORAGE_BACKEND=r2)
# Get these values from Cloudflare R2 dashboard
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=marcomarchione-bucket-dev
R2_PUBLIC_URL=https://your-bucket.your-domain.com
